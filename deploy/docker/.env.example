# 复制为 .env 后修改。不要把填好的 .env 提交到版本库或发给无关的人。

# ---- 应用对外端口（宿主机）----
AUTH_PRO_PORT=19127

# ---- MariaDB（compose 服务名固定为 db）----
MYSQL_ROOT_PASSWORD=请改成足够长的随机口令
MYSQL_DATABASE=auth_pro
MYSQL_USER=auth_pro
MYSQL_PASSWORD=请改成与业务库账号对应的口令

# 应用连接库（容器内主机名是 db，不要写成 127.0.0.1）
AUTO_PRO_DB_HOST=db
AUTO_PRO_DB_PORT=3306
AUTO_PRO_DB_NAME=auth_pro
AUTO_PRO_DB_USER=auth_pro
AUTO_PRO_DB_PASSWORD=请与上面 MYSQL_PASSWORD 保持一致

# 可选：时区
TZ=Asia/Shanghai

# 可选：打到镜像上的标签（默认 1.9.1）
# AUTH_PRO_IMAGE_TAG=1.9.1
# AUTH_PRO_VERSION=1.9.1
