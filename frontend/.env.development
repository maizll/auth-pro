# 【开发】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 请求基础路径（开发环境设置为 / 使用代理，生产环境设置为完整后端地址）
VITE_API_URL = /

# 代理目标地址（开发环境通过 Vite 代理转发请求到此地址，解决跨域问题）
VITE_API_PROXY_URL = http://localhost:19127

# 产品默认 backend：侧栏以「菜单管理」和 GET /api/system/menus 为准。
# 本地对照静态路由时，可临时改为 frontend。不要当作产品默认。
VITE_ACCESS_MODE = backend

# Delete console
VITE_DROP_CONSOLE = false
