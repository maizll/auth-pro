#!/bin/sh
# 由在线更新生成。先替换磁盘上的程序，再结束旧进程。
# 进程守护模式下不要自行 nohup，避免再拉起一个脱离守护的孤儿进程。
set -u
trap '' HUP

FRONTEND_ONLY=0
if [ "${1:-}" = "--frontend-only" ]; then
  FRONTEND_ONLY=1
fi

APP_PID=__APP_PID__
APP_BIN=__APP_BIN__
NEW_BIN=__NEW_BIN__
FRONTEND_SOURCE=__FRONTEND_SOURCE__
FRONTEND_CURRENT=__FRONTEND_CURRENT__
DATA_DIR=__DATA_DIR__
SERVICE_NAME=__SERVICE_NAME__
PORT=__PORT__
VERSION=__VERSION__
OLD_VERSION=__OLD_VERSION__
LOG_FILE=__LOG_FILE__
JOB_RESULT=__JOB_RESULT__
PROCESS_MANAGER=__PROCESS_MANAGER__
SUPERVISOR_PROGRAM=__SUPERVISOR_PROGRAM__
SUPERVISOR_CONF=__SUPERVISOR_CONF__
HEALTH_TRIES=__HEALTH_TRIES__
GUARDIAN_START_B64='__GUARDIAN_START_B64__'
STARTED_PID=""

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOG_FILE"
}

finish_job() {
  status="$1"
  reason="${2:-}"
  printf '%s\n%s\n' "$status" "$reason" > "$JOB_RESULT.tmp"
  mv -f "$JOB_RESULT.tmp" "$JOB_RESULT"
}

if [ "$FRONTEND_ONLY" != "1" ]; then
  sleep 2
fi
TS=$(date '+%Y%m%d%H%M%S')

FRONTEND_MODE=""
PREV_FRONTEND_TARGET=""
FRONTEND_BACKUP=""
TARGET_RELEASE=""
if [ ! -d "$FRONTEND_CURRENT" ] && [ ! -L "$FRONTEND_CURRENT" ]; then
  log "frontend directory not found: $FRONTEND_CURRENT"
  finish_job failed "未找到前端目录，更新已停止"
  exit 1
fi

OVERLAY=0
OVERLAY_MOVED=""
OVERLAY_PLACED=""
rollback_overlay() {
  for name in $OVERLAY_PLACED; do
    rm -rf "$FRONTEND_CURRENT/$name"
  done
  for name in $OVERLAY_MOVED; do
    if [ -e "$FRONTEND_BACKUP/$name" ] || [ -L "$FRONTEND_BACKUP/$name" ]; then
      rm -rf "$FRONTEND_CURRENT/$name"
      mv "$FRONTEND_BACKUP/$name" "$FRONTEND_CURRENT/$name" || true
    fi
  done
}
case "$APP_BIN" in
  "$FRONTEND_CURRENT"/*) OVERLAY=1 ;;
esac
case "$DATA_DIR" in
  "$FRONTEND_CURRENT"|"$FRONTEND_CURRENT"/*) OVERLAY=1 ;;
esac

if [ "$OVERLAY" = "1" ]; then
  # 宝塔网站根同时放着页面和 backend/。不能把整个网站根改名，否则运行中的程序和数据目录会一起被搬走。
  FRONTEND_MODE="overlay"
  STAGING="${FRONTEND_CURRENT}.staging.$TS"
  FRONTEND_BACKUP="${FRONTEND_CURRENT}.overlay-backup.$TS"
  rm -rf "$STAGING"
  cp -a "$FRONTEND_SOURCE" "$STAGING" || {
    rm -rf "$STAGING"
    finish_job failed "复制前端暂存目录失败，线上目录未改动"
    exit 1
  }
  if [ ! -f "$STAGING/index.html" ]; then
    rm -rf "$STAGING"
    finish_job failed "新前端缺少 index.html，线上目录未改动"
    exit 1
  fi
  mkdir -p "$FRONTEND_BACKUP" || { rm -rf "$STAGING"; finish_job failed "无法创建前端备份目录"; exit 1; }
  for name in $(ls -A "$STAGING"); do
    case "$name" in
      backend|manifest.json) continue ;;
    esac
    if [ -e "$FRONTEND_CURRENT/$name" ] || [ -L "$FRONTEND_CURRENT/$name" ]; then
      mv "$FRONTEND_CURRENT/$name" "$FRONTEND_BACKUP/$name" || {
        rollback_overlay
        finish_job failed "无法备份线上前端文件 $name"
        exit 1
      }
      OVERLAY_MOVED="$OVERLAY_MOVED $name"
    fi
    mv "$STAGING/$name" "$FRONTEND_CURRENT/$name" || {
      rollback_overlay
      finish_job failed "无法切换前端文件 $name"
      exit 1
    }
    OVERLAY_PLACED="$OVERLAY_PLACED $name"
  done
  rm -rf "$STAGING"
  log "frontend overlay switched at $FRONTEND_CURRENT"
elif [ -L "$FRONTEND_CURRENT" ] || [ "$(basename "$FRONTEND_CURRENT")" = "current" ]; then
  FRONTEND_MODE="release"
  FRONT_ROOT=$(dirname "$FRONTEND_CURRENT")
  RELEASES="$FRONT_ROOT/releases"
  TARGET_RELEASE="$RELEASES/$VERSION"
  mkdir -p "$RELEASES" || { finish_job failed "无法创建前端发布目录"; exit 1; }
  rm -rf "$TARGET_RELEASE"
  cp -a "$FRONTEND_SOURCE" "$TARGET_RELEASE" || { rm -rf "$TARGET_RELEASE"; finish_job failed "复制前端发布目录失败"; exit 1; }
  if [ ! -f "$TARGET_RELEASE/index.html" ]; then
    rm -rf "$TARGET_RELEASE"
    log "staged frontend missing index.html"
    finish_job failed "新前端缺少 index.html"
    exit 1
  fi
  if [ -L "$FRONTEND_CURRENT" ]; then
    PREV_FRONTEND_TARGET=$(readlink "$FRONTEND_CURRENT" || true)
    rm -f "$FRONTEND_CURRENT"
  else
    FRONTEND_BACKUP="$FRONT_ROOT/current.backup.$TS"
    mv "$FRONTEND_CURRENT" "$FRONTEND_BACKUP" || { finish_job failed "无法移开当前前端目录"; exit 1; }
  fi
  ln -s "$TARGET_RELEASE" "$FRONTEND_CURRENT" || {
    if [ -n "$PREV_FRONTEND_TARGET" ]; then
      ln -s "$PREV_FRONTEND_TARGET" "$FRONTEND_CURRENT" || true
    elif [ -n "$FRONTEND_BACKUP" ] && [ -d "$FRONTEND_BACKUP" ]; then
      mv "$FRONTEND_BACKUP" "$FRONTEND_CURRENT" || true
    fi
    finish_job failed "切换前端符号链接失败，已尝试恢复"
    exit 1
  }
  log "frontend release switched to $TARGET_RELEASE"
else
  FRONTEND_MODE="rename"
  STAGING="${FRONTEND_CURRENT}.staging.$TS"
  FRONTEND_BACKUP="${FRONTEND_CURRENT}.backup.$TS"
  rm -rf "$STAGING"
  cp -a "$FRONTEND_SOURCE" "$STAGING" || {
    rm -rf "$STAGING"
    log "frontend staging copy failed"
    finish_job failed "复制前端暂存目录失败，线上目录未改动"
    exit 1
  }
  if [ ! -f "$STAGING/index.html" ]; then
    rm -rf "$STAGING"
    log "staged frontend missing index.html"
    finish_job failed "新前端缺少 index.html，线上目录未改动"
    exit 1
  fi
  mv "$FRONTEND_CURRENT" "$FRONTEND_BACKUP" || {
    rm -rf "$STAGING"
    log "frontend live directory could not be moved aside"
    finish_job failed "无法移开线上前端目录"
    exit 1
  }
  mv "$STAGING" "$FRONTEND_CURRENT" || {
    mv "$FRONTEND_BACKUP" "$FRONTEND_CURRENT" || true
    rm -rf "$STAGING"
    log "frontend staged directory could not be switched into place"
    finish_job failed "前端切换失败，已尝试恢复旧目录"
    exit 1
  }
  log "frontend switched by rename at $FRONTEND_CURRENT"
fi

if [ "$FRONTEND_ONLY" = "1" ]; then
  log "frontend switch completed"
  finish_job success
  exit 0
fi

BACKUP_BIN="$APP_BIN.backup.$TS"
APP_STAGE="$APP_BIN.next.$TS"

rollback_frontend() {
  if [ "$FRONTEND_MODE" = "overlay" ]; then
    rollback_overlay
    return
  fi
  if [ "$FRONTEND_MODE" = "rename" ]; then
    if [ -d "$FRONTEND_BACKUP" ]; then
      FAILED_FRONTEND="${FRONTEND_CURRENT}.failed.$TS"
      if [ -e "$FRONTEND_CURRENT" ] || [ -L "$FRONTEND_CURRENT" ]; then
        mv "$FRONTEND_CURRENT" "$FAILED_FRONTEND" || true
      fi
      if ! mv "$FRONTEND_BACKUP" "$FRONTEND_CURRENT"; then
        if [ -e "$FAILED_FRONTEND" ] || [ -L "$FAILED_FRONTEND" ]; then
          mv "$FAILED_FRONTEND" "$FRONTEND_CURRENT" || true
        fi
      else
        rm -rf "$FAILED_FRONTEND"
      fi
    fi
    return
  fi
  if [ "$FRONTEND_MODE" = "release" ]; then
    if [ -n "$PREV_FRONTEND_TARGET" ]; then
      rm -f "$FRONTEND_CURRENT"
      ln -s "$PREV_FRONTEND_TARGET" "$FRONTEND_CURRENT"
    elif [ -n "$FRONTEND_BACKUP" ] && [ -d "$FRONTEND_BACKUP" ]; then
      rm -f "$FRONTEND_CURRENT"
      mv "$FRONTEND_BACKUP" "$FRONTEND_CURRENT"
    fi
  fi
}

port_listening() {
  if command -v ss >/dev/null 2>&1; then
    if ss -ltn 2>/dev/null | awk '{print $4}' | grep -Eq "(^|:)${PORT}$"; then
      return 0
    fi
    return 1
  fi
  if command -v netstat >/dev/null 2>&1; then
    if netstat -ltn 2>/dev/null | awk '{print $4}' | grep -Eq "(^|:)${PORT}$"; then
      return 0
    fi
    return 1
  fi
  if command -v nc >/dev/null 2>&1; then
    nc -z 127.0.0.1 "$PORT" >/dev/null 2>&1
    return $?
  fi
  return 1
}

pids_on_port() {
  if command -v ss >/dev/null 2>&1; then
    ss -lptn "sport = :$PORT" 2>/dev/null | sed -n 's/.*pid=\([0-9][0-9]*\).*/\1/p' | sort -u
    return 0
  fi
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null || true
    return 0
  fi
  if command -v fuser >/dev/null 2>&1; then
    fuser "${PORT}/tcp" 2>/dev/null || true
    return 0
  fi
  return 0
}

stop_pid() {
  pid="$1"
  if [ -z "${pid:-}" ] || [ "$pid" = "1" ]; then
    return 0
  fi
  kill -0 "$pid" >/dev/null 2>&1 || return 0
  kill -TERM "$pid" >/dev/null 2>&1 || true
  i=0
  while [ "$i" -lt 15 ]; do
    if ! kill -0 "$pid" >/dev/null 2>&1; then
      return 0
    fi
    i=$((i + 1))
    sleep 1
  done
  kill -KILL "$pid" >/dev/null 2>&1 || true
  sleep 1
}

wait_port_free() {
  i=0
  while [ "$i" -lt 20 ]; do
    if ! port_listening; then
      return 0
    fi
    i=$((i + 1))
    sleep 1
  done
  return 1
}

# 端口上只处理本站 auth_pro（含 PPID=1 的孤儿）。其它程序或其它站点直接拒绝。
# 成功时端口保持空闲。失败时 RECLAIM_REASON 是给任务和日志的中文说明。
reclaim_port() {
  RECLAIM_REASON=""
  if ! port_listening; then
    sleep 1
    if ! port_listening; then
      return 0
    fi
  fi
  pids="$(pids_on_port || true)"
  if [ -z "$pids" ]; then
    RECLAIM_REASON="端口 ${PORT} 仍在监听，但当前用户看不到占用进程。请用 root 执行 ss -lptn，先在宝塔进程守护中停止本站点。本次没有启动新进程。"
    log "$RECLAIM_REASON"
    return 1
  fi
  foreign=""
  for pid in $pids; do
    case "$pid" in
      ''|*[!0-9]*) continue ;;
    esac
    target="$(our_root "$pid" || true)"
    if [ -z "$target" ]; then
      foreign="$pid"
      break
    fi
    log "port $PORT still held by this site auth_pro pid=$target ppid=$(ppid_of "$target"), stopping it"
    stop_pid "$target"
  done
  if [ -n "$foreign" ]; then
    exe="$(exe_of "$foreign")"
    cmd="$(cmdline_of "$foreign")"
    parent="$(ppid_of "$foreign")"
    RECLAIM_REASON="端口 ${PORT} 被 PID ${foreign}（PPID ${parent}，程序 ${exe}，命令 ${cmd}）占用，不是本站 ${APP_BIN}。已拒绝结束该进程，也没有启动新进程。请确认是不是同机其它站点或其它程序。"
    log "$RECLAIM_REASON"
    return 1
  fi
  if ! wait_port_free; then
    RECLAIM_REASON="已要求本站 auth_pro 退出，但端口 ${PORT} 仍被占用。请先在宝塔进程守护里停止本站点，再重新执行。本次没有启动新进程。"
    log "$RECLAIM_REASON"
    return 1
  fi
  sleep 1
  if port_listening; then
    RECLAIM_REASON="端口 ${PORT} 刚释放又被占用。进程守护可能在停止后立刻拉起了进程。请先在宝塔进程守护里停止本站点。本次没有启动新进程。"
    log "$RECLAIM_REASON"
    return 1
  fi
  return 0
}

stop_old_process() {
  log "stopping old process before starting the new one"
  if [ "$PROCESS_MANAGER" = "systemd" ]; then
    systemctl stop "$SERVICE_NAME" >/dev/null 2>&1 || log "systemctl stop $SERVICE_NAME did not succeed, will still wait for the old pid"
  elif supervised_manager; then
    supervisor_ctl stop "$SUPERVISOR_PROGRAM" >/dev/null 2>&1 || log "supervisorctl stop $SUPERVISOR_PROGRAM did not succeed, will still clear this site's listener"
  fi
  stop_pid "$APP_PID"
  reclaim_port
}

fetch_health() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsS --max-time 2 "http://127.0.0.1:$PORT/api/system/version" 2>/dev/null || true
    return 0
  fi
  if command -v wget >/dev/null 2>&1; then
    wget -qO- -T 2 "http://127.0.0.1:$PORT/api/system/version" 2>/dev/null || true
    return 0
  fi
  return 0
}

health_version() {
  want="$1"
  i=0
  while [ "$i" -lt "$HEALTH_TRIES" ]; do
    sleep 1
    body=$(fetch_health)
    if printf '%s' "$body" | grep -Fq "\"version\":\"$want\""; then
      return 0
    fi
    i=$((i + 1))
  done
  return 1
}

exe_of() {
  pid="$1"
  target="$(readlink "/proc/$pid/exe" 2>/dev/null || true)"
  target="${target% (deleted)}"
  printf '%s' "$target"
}

cmdline_of() {
  pid="$1"
  tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true
}

ppid_of() {
  pid="$1"
  awk '/^PPid:/ {print $2}' "/proc/$pid/status" 2>/dev/null || true
}

# 只认本站这份 backend/auth_pro。同机其它目录里的 auth_pro 不算。
is_our_pid() {
  pid="$1"
  case "$pid" in
    ''|*[!0-9]*|1) return 1 ;;
  esac
  exe="$(exe_of "$pid")"
  cmd="$(cmdline_of "$pid")"
  if [ "$exe" = "$APP_BIN" ] || [ "$cmd" = "$APP_BIN" ]; then
    return 0
  fi
  case " $cmd " in
    *" $APP_BIN "*|*" $APP_BIN") return 0 ;;
  esac
  return 1
}

# 监听者本身或它上面几层父进程是本站程序时，返回应该结束的那个 pid。
our_root() {
  pid="$1"
  current="$1"
  i=0
  while [ -n "$current" ] && [ "$current" != "1" ] && [ "$i" -lt 6 ]; do
    if is_our_pid "$current"; then
      printf '%s' "$current"
      return 0
    fi
    parent="$(ppid_of "$current")"
    if [ -z "$parent" ] || [ "$parent" = "$current" ]; then
      return 1
    fi
    current="$parent"
    i=$((i + 1))
  done
  return 1
}

start_standalone() {
  if port_listening; then
    log "refusing standalone start because port $PORT is still busy"
    return 1
  fi
  mkdir -p "$DATA_DIR/logs"
  cd "$DATA_DIR" || return 1
  # 仅无守护、且端口已确认空闲时自行拉起。
  AUTO_PRO_DATA_DIR="$DATA_DIR" PORT="$PORT" nohup "$APP_BIN" >> "$DATA_DIR/logs/auto_pro.log" 2>&1 &
  STARTED_PID=$!
}

start_managed() {
  if port_listening; then
    log "refusing managed start because port $PORT is still busy"
    return 1
  fi
  if [ "$PROCESS_MANAGER" = "systemd" ]; then
    systemctl start "$SERVICE_NAME"
    return $?
  fi
  supervisor_ctl start "$SUPERVISOR_PROGRAM"
}

prune_binary_backups() {
  ls -1t "$APP_BIN".backup.* 2>/dev/null | awk 'NR>3' | while read -r old; do
    rm -f "$old"
  done
  return 0
}

supervisor_ctl() {
  if ! command -v supervisorctl >/dev/null 2>&1; then
    return 127
  fi
  if [ -n "$SUPERVISOR_CONF" ]; then
    supervisorctl -c "$SUPERVISOR_CONF" "$@"
  else
    supervisorctl "$@"
  fi
}

supervised_manager() {
  case "$PROCESS_MANAGER" in
    supervisor|baota|systemd) return 0 ;;
  esac
  return 1
}

# 给 handoff.sh 写安全的单引号字面量。
sq() {
  printf '%s\n' "$1" | sed "s/'/'\\\\''/g; 1s/^/'/; \$s/\$/'/"
}

# 父进程链上有 supervisord，或这是 systemd 拉起的服务（带 INVOCATION_ID 且最终父进程为 1）。
# 父进程直接是 1 且没有 INVOCATION_ID 的是孤儿，不能指望守护会重启它。
guardian_owns_pid() {
  pid="$1"
  case "$pid" in
    ''|*[!0-9]*|1) return 1 ;;
  esac
  current="$pid"
  i=0
  while [ "$i" -lt 8 ]; do
    parent="$(ppid_of "$current")"
    case "$parent" in
      ''|*[!0-9]*) return 1 ;;
    esac
    if [ "$parent" = "1" ]; then
      if tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -q '^INVOCATION_ID='; then
        return 0
      fi
      return 1
    fi
    comm="$(tr -d ' \n' < "/proc/$parent/comm" 2>/dev/null || true)"
    case "$comm" in
      supervisord|supervisor|systemd) return 0 ;;
    esac
    if tr '\0' ' ' < "/proc/$parent/cmdline" 2>/dev/null | grep -Fq 'supervisord'; then
      return 0
    fi
    current="$parent"
    i=$((i + 1))
  done
  return 1
}

install_guardian_start() {
  if ! command -v base64 >/dev/null 2>&1; then
    log "base64 is required to install start.sh"
    return 1
  fi
  if ! command -v bash >/dev/null 2>&1; then
    log "bash is required to install start.sh"
    return 1
  fi
  mkdir -p "$DATA_DIR" || return 1
  if ! printf '%s' "$GUARDIAN_START_B64" | base64 -d > "$DATA_DIR/start.sh.next"; then
    rm -f "$DATA_DIR/start.sh.next"
    return 1
  fi
  if ! grep -q 'auth-pro-guardian-start' "$DATA_DIR/start.sh.next"; then
    rm -f "$DATA_DIR/start.sh.next"
    log "decoded start.sh is missing the guardian marker"
    return 1
  fi
  if ! bash -n "$DATA_DIR/start.sh.next"; then
    rm -f "$DATA_DIR/start.sh.next"
    return 1
  fi
  chmod 755 "$DATA_DIR/start.sh.next" || { rm -f "$DATA_DIR/start.sh.next"; return 1; }
  mv -f "$DATA_DIR/start.sh.next" "$DATA_DIR/start.sh"
}

write_pending_handoff() {
  pending="$DATA_DIR/updates/pending-restart"
  rm -rf "$pending"
  mkdir -p "$pending" || return 1
  {
    printf 'EXPECT_VERSION=%s\n' "$(sq "$VERSION")"
    printf 'OLD_VERSION=%s\n' "$(sq "$OLD_VERSION")"
    printf 'PORT=%s\n' "$(sq "$PORT")"
    printf 'APP_BIN=%s\n' "$(sq "$APP_BIN")"
    printf 'BACKUP_BIN=%s\n' "$(sq "$BACKUP_BIN")"
    printf 'JOB_RESULT=%s\n' "$(sq "$JOB_RESULT")"
    printf 'LOG_FILE=%s\n' "$(sq "$LOG_FILE")"
    printf 'HEALTH_TRIES=%s\n' "$(sq "$HEALTH_TRIES")"
    printf 'MAX_ATTEMPTS=%s\n' "2"
    printf 'PENDING_DIR=%s\n' "$(sq "$pending")"
    printf 'FRONTEND_MODE=%s\n' "$(sq "$FRONTEND_MODE")"
    printf 'FRONTEND_CURRENT=%s\n' "$(sq "$FRONTEND_CURRENT")"
    printf 'FRONTEND_BACKUP=%s\n' "$(sq "$FRONTEND_BACKUP")"
    printf 'PREV_FRONTEND_TARGET=%s\n' "$(sq "$PREV_FRONTEND_TARGET")"
    printf 'OVERLAY_MOVED=%s\n' "$(sq "$OVERLAY_MOVED")"
    printf 'OVERLAY_PLACED=%s\n' "$(sq "$OVERLAY_PLACED")"
    printf 'TS=%s\n' "$(sq "$TS")"
  } > "$pending/handoff.sh" || return 1
  cat >> "$pending/handoff.sh" <<'HANDOFF_FUNCS'
log_handoff() {
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOG_FILE"
}

finish_handoff() {
  status="$1"
  reason="${2:-}"
  printf '%s\n%s\n' "$status" "$reason" > "${JOB_RESULT}.tmp"
  mv -f "${JOB_RESULT}.tmp" "$JOB_RESULT"
}

handoff_port_listening() {
  if command -v ss >/dev/null 2>&1; then
    if ss -ltn 2>/dev/null | awk '{print $4}' | grep -Eq "(^|:)${PORT}$"; then
      return 0
    fi
    return 1
  fi
  if command -v nc >/dev/null 2>&1; then
    nc -z 127.0.0.1 "$PORT" >/dev/null 2>&1
    return $?
  fi
  return 1
}

handoff_wait_port_free() {
  i=0
  while [ "$i" -lt 20 ]; do
    if ! handoff_port_listening; then
      return 0
    fi
    i=$((i + 1))
    sleep 1
  done
  log_handoff "port $PORT still busy"
  return 1
}

handoff_health_ok() {
  child="$1"
  i=0
  while [ "$i" -lt "$HEALTH_TRIES" ]; do
    if ! kill -0 "$child" 2>/dev/null; then
      log_handoff "new process exited before the health check passed"
      return 1
    fi
    body=""
    if command -v curl >/dev/null 2>&1; then
      body=$(curl -fsS --max-time 2 "http://127.0.0.1:${PORT}/api/system/version" 2>/dev/null || true)
    elif command -v wget >/dev/null 2>&1; then
      body=$(wget -qO- -T 2 "http://127.0.0.1:${PORT}/api/system/version" 2>/dev/null || true)
    fi
    if printf '%s' "$body" | grep -Fq "\"version\":\"$EXPECT_VERSION\""; then
      return 0
    fi
    i=$((i + 1))
    sleep 1
  done
  log_handoff "health check timed out waiting for $EXPECT_VERSION"
  return 1
}

rollback_frontend_files() {
  if [ "$FRONTEND_MODE" = "overlay" ]; then
    for name in $OVERLAY_PLACED; do
      rm -rf "$FRONTEND_CURRENT/$name"
    done
    for name in $OVERLAY_MOVED; do
      if [ -e "$FRONTEND_BACKUP/$name" ] || [ -L "$FRONTEND_BACKUP/$name" ]; then
        rm -rf "$FRONTEND_CURRENT/$name"
        mv "$FRONTEND_BACKUP/$name" "$FRONTEND_CURRENT/$name" || true
      fi
    done
    return 0
  fi
  if [ "$FRONTEND_MODE" = "rename" ]; then
    if [ -n "$FRONTEND_BACKUP" ] && [ -d "$FRONTEND_BACKUP" ]; then
      failed="${FRONTEND_CURRENT}.failed.$TS"
      if [ -e "$FRONTEND_CURRENT" ] || [ -L "$FRONTEND_CURRENT" ]; then
        mv "$FRONTEND_CURRENT" "$failed" || true
      fi
      if mv "$FRONTEND_BACKUP" "$FRONTEND_CURRENT"; then
        rm -rf "$failed"
      elif [ -e "$failed" ] || [ -L "$failed" ]; then
        mv "$failed" "$FRONTEND_CURRENT" || true
      fi
    fi
    return 0
  fi
  if [ "$FRONTEND_MODE" = "release" ]; then
    if [ -n "$PREV_FRONTEND_TARGET" ]; then
      rm -f "$FRONTEND_CURRENT"
      ln -s "$PREV_FRONTEND_TARGET" "$FRONTEND_CURRENT" || true
    elif [ -n "$FRONTEND_BACKUP" ] && [ -d "$FRONTEND_BACKUP" ]; then
      rm -f "$FRONTEND_CURRENT"
      mv "$FRONTEND_BACKUP" "$FRONTEND_CURRENT" || true
    fi
  fi
  return 0
}

handoff_mark_success() {
  log_handoff "update to $EXPECT_VERSION succeeded under the process guardian"
  finish_handoff success ""
  ls -1t "$APP_BIN".backup.* 2>/dev/null | awk 'NR>3' | while read -r old; do
    rm -f "$old"
  done || true
  rm -rf "$PENDING_DIR"
}

handoff_rollback() {
  reason="$1"
  log_handoff "rolling back: $reason"
  if [ -f "$BACKUP_BIN" ]; then
    cp -a "$BACKUP_BIN" "$APP_BIN" || true
    chmod 755 "$APP_BIN" || true
  fi
  rollback_frontend_files || true
  finish_handoff failed "$reason" || true
  rm -rf "$PENDING_DIR" || true
}
HANDOFF_FUNCS
  if ! sh -n "$pending/handoff.sh"; then
    rm -rf "$pending"
    return 1
  fi
  return 0
}

if [ ! -f "$NEW_BIN" ]; then
  log "new backend binary not found: $NEW_BIN"
  rollback_frontend
  finish_job failed "更新包里没有新的后端程序"
  exit 1
fi
if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then
  log "curl or wget is required for health check"
  rollback_frontend
  finish_job failed "缺少 curl 或 wget，无法做启动健康检查"
  exit 1
fi

# BEGIN GUARDIAN HANDOFF
# 守护正在托管本进程时，不要去停守护。宝塔面板自带的守护经常连不上更新脚本手里的控制命令，
# 停不住就会在杀进程后立刻把旧二进制拉起来。先替换磁盘上的程序，写待验证标记，再只结束本进程。
if supervised_manager && guardian_owns_pid "$APP_PID"; then
  log "guardian owns pid $APP_PID; replacing files without stopping the guardian"
  if ! cp "$APP_BIN" "$BACKUP_BIN"; then
    rollback_frontend
    finish_job failed "无法备份当前后端程序，没有退出进程"
    exit 1
  fi
  if ! cp "$NEW_BIN" "$APP_STAGE"; then
    rm -f "$BACKUP_BIN"
    rollback_frontend
    finish_job failed "无法写入新后端程序，没有退出进程"
    exit 1
  fi
  if ! chmod 755 "$APP_STAGE"; then
    rm -f "$APP_STAGE" "$BACKUP_BIN"
    rollback_frontend
    finish_job failed "无法设置新后端程序权限，没有退出进程"
    exit 1
  fi
  if ! mv -f "$APP_STAGE" "$APP_BIN"; then
    rm -f "$APP_STAGE"
    rollback_frontend
    finish_job failed "无法替换后端程序，没有退出进程"
    exit 1
  fi
  chmod 755 "$APP_BIN" || true
  if ! install_guardian_start; then
    if [ -f "$BACKUP_BIN" ]; then
      cp -a "$BACKUP_BIN" "$APP_BIN" || true
      chmod 755 "$APP_BIN" || true
    fi
    rollback_frontend
    finish_job failed "无法更新启动脚本 start.sh，已恢复旧程序，没有退出进程"
    exit 1
  fi
  if ! write_pending_handoff; then
    if [ -f "$BACKUP_BIN" ]; then
      cp -a "$BACKUP_BIN" "$APP_BIN" || true
      chmod 755 "$APP_BIN" || true
    fi
    rollback_frontend
    finish_job failed "无法写入待验证标记，已恢复旧程序，没有退出进程"
    exit 1
  fi
  log "signaling pid $APP_PID so the process guardian can start start.sh"
  stop_pid "$APP_PID"
  exit 0
fi
# END GUARDIAN HANDOFF

# BEGIN STANDALONE RESTART
cp "$APP_BIN" "$BACKUP_BIN" || { rollback_frontend; finish_job failed "无法备份当前后端程序"; exit 1; }
cp "$NEW_BIN" "$APP_STAGE" || { rollback_frontend; finish_job failed "无法写入新后端程序暂存文件"; exit 1; }
chmod 755 "$APP_STAGE" || { rm -f "$APP_STAGE"; rollback_frontend; finish_job failed "无法设置新后端程序权限"; exit 1; }

restore_old_binary() {
  if [ -f "$BACKUP_BIN" ]; then
    mv -f "$BACKUP_BIN" "$APP_BIN" || cp -a "$BACKUP_BIN" "$APP_BIN" || true
    chmod 755 "$APP_BIN" || true
  fi
}

bring_old_back() {
  restore_old_binary
  rollback_frontend
  if port_listening; then
    log "old version was not started because port $PORT is still busy"
    return 0
  fi
  if supervised_manager; then
    start_managed || log "failed to start the previous version via the process manager"
  else
    start_standalone || log "failed to start the previous version"
  fi
}

# 先停旧进程并确认端口空闲，再换上新文件、再启动。不要在旧进程还占着端口时拉起新进程。
if ! stop_old_process; then
  rm -f "$APP_STAGE"
  reason="${RECLAIM_REASON:-停止旧进程后端口 ${PORT} 仍不可用，没有启动新进程。}"
  bring_old_back
  finish_job failed "$reason"
  exit 1
fi
if ! mv -f "$APP_STAGE" "$APP_BIN"; then
  rm -f "$APP_STAGE"
  bring_old_back
  finish_job failed "旧进程已停止，但无法替换后端程序，已尝试拉起旧版本"
  exit 1
fi
chmod 755 "$APP_BIN" || true
prune_binary_backups
log "binary replaced after the old process released port $PORT, process manager=$PROCESS_MANAGER"
if port_listening; then
  if ! reclaim_port; then
    bring_old_back
    finish_job failed "${RECLAIM_REASON:-替换程序后端口 ${PORT} 又被占用，没有启动新进程。}"
    exit 1
  fi
fi

rollback_failed_update() {
  log "health check failed, rolling back"
  if [ "$PROCESS_MANAGER" = "systemd" ]; then
    systemctl stop "$SERVICE_NAME" >/dev/null 2>&1 || true
  elif supervised_manager; then
    supervisor_ctl stop "$SUPERVISOR_PROGRAM" >/dev/null 2>&1 || true
  fi
  stop_pid "$STARTED_PID"
  stop_pid "$APP_PID"
  reclaim_port || log "rollback could not clear port $PORT: ${RECLAIM_REASON:-unknown}"
  restore_old_binary
  rollback_frontend
  if ! port_listening; then
    if supervised_manager; then
      start_managed || true
    else
      start_standalone || true
    fi
  fi
}

if ! port_listening; then
  log "port free, starting new process"
else
  bring_old_back
  finish_job failed "端口 ${PORT} 还没空闲，拒绝启动新进程"
  exit 1
fi

if supervised_manager; then
  log "supervised restart"
  if ! start_managed; then
    rollback_failed_update
    finish_job failed "进程守护没有启动新版本。请查看守护日志。已尝试回滚到 ${OLD_VERSION}。"
    exit 1
  fi
else
  log "standalone restart"
  if ! start_standalone; then
    bring_old_back
    finish_job failed "端口 ${PORT} 未确认空闲，没有自行拉起新进程"
    exit 1
  fi
fi

if health_version "$VERSION"; then
  log "update to $VERSION succeeded"
  finish_job success
  exit 0
fi
rollback_failed_update
reason="新版本在 ${HEALTH_TRIES} 秒内没有健康启动，已尝试回滚到 ${OLD_VERSION}"
if health_version "$OLD_VERSION"; then
  reason="${reason}。旧版本已重新拉起。"
else
  reason="${reason}。旧版本未能自动拉起。请在宝塔进程守护中停止本站点，确认端口 ${PORT} 没有残留的本站 auth_pro 后再由守护启动。"
fi
log "$reason"
finish_job failed "$reason"
exit 1
# END STANDALONE RESTART
